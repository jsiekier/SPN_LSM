#!/bin/bash
#SBATCH -t 12:00:00 #02:00:00 #5 hours#02:00:00#
#SBATCH -A ki-dm #ki-topml #
#SBATCH -p a40 #a100ai # #bigmem #parallel #m2_gpu #bigmem # devel -64,96,128 GB Max
#SBATCH --mem=246000 #246000 #360000 # 360000 #512000 #memory in MB#36000# 246000
#SBATCH -J spn_eval #linkage
#SBATCH --mail-type=None
#SBATCH -o spn_eval-%A.%a.output
#SBATCH -e spn_eval-%A.%a.error
#SBATCH -n 1 #number of tasks
#SBATCH -c 1 #number of cores (use more for multithreading)
