model_names="$1"
eval_method="$2"
dataset_name="$3"



nvidia-smi

apptainer exec --nv \
    -B /lustre/project/ki-topml/jsiekiera/micromamba_envs:/envs \
    -B /lustre/project/ki-topml/jsiekiera:/data_in \
    docker://tensorflow/tensorflow:2.13.0-gpu \
    /envs/envs/cnn_spn/bin/python main_analysis.py --model_names "$model_names" --eval_method "$eval_method" --fine_tune $SLURM_ARRAY_TASK_ID --dataset_name "$dataset_name"




