#!/bin/bash
#SBATCH -t 50:00:00 #5 hours#02:00:00#
#SBATCH -A ki-dm #
#SBATCH -p a100ai # a40 ## ## # topml #bigmem #parallel #m2_gpu #bigmem # devel -64,96,128 GB Max
#SBATCH --mem=100G #246000 #246000 #360000 # 360000 #512000 #memory in MB#36000# 246000
#SBATCH -J spn_cnn_train #linkage
#SBATCH --mail-type=None
#SBATCH -o spn_train-%A.%a.output
#SBATCH -e spn_train-%A.%a.error
#SBATCH -n 1 #number of tasks
#SBATCH -c 1 #number of cores (use more for multithreading)
#SBATCH --gres=gpu:1


module load tools/Apptainer/1.3.4-GCCcore-13.3.0

source /home/jsiekier/.bashrc
conda_initialize
micromamba activate cnn_spn
export PYTHONNOUSERSITE=1


export SINGULARITY_TMPDIR=/lustre/project/ki-topml/jsiekiera/apptainer_tmp
export APPTAINER_CACHEDIR=/lustre/project/ki-topml/jsiekiera/apptainer_cache



save_path="$1"
dataset_name="$2"
kld="$3"
rec="$4"
ld="$5"
act="$6"
le="$7"

nvidia-smi

apptainer exec --nv \
    -B /lustre/project/ki-topml/jsiekiera/micromamba_envs:/envs \
    -B /lustre/project/ki-topml/jsiekiera:/data_in \
    docker://tensorflow/tensorflow:2.13.0-gpu \
    /envs/envs/cnn_spn/bin/python main_pipeline.py  --min_features_slice 1 --use_KLD_anneal 0 --epochs 100 --fine_tune_its 52 --conv_dim 3 --rec_loss "$rec" --batchnorm_integration 0 --use_VAE 1 --regression 10 --col_split "rdc" --diff_privacy 0 --machine 'mogon' --dataset_name "$dataset_name" --le_warmup 0 --load_pretrain_model 0 --gauss_std 0.0 --save_path "$save_path" --loss_weights 1.0 $kld 1.0 --dropout 0.0 --use_add_info 0 --VAE_debug 0 --latent_dim $ld --separate_view 0 --learning_rate "$le" --fine_tune_rate "$le" --batch_size 100 --shortcut 1 --activation "$act" --VAE_fine_tune "SPN_VAE_MLP"



